{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug APP (OpenOCD+J-Link, ATSAM3X8E)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/due_app.elf",
      "device": "ATSAM3X8E",
      "interface": "swd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "configFiles": [
        "${workspaceFolder}/tools/openocd_jlink_swd_sam3x.cfg"
      ],
      "searchDir": [
        "/usr/share/openocd/scripts"
      ],
      "runToEntryPoint": "main",
      "preLaunchTask": "Build (due2)",
      "svdFile": "${workspaceFolder}/svd/SAM3X8E.svd"
    },
    {
      "name": "Debug BL (OpenOCD+J-Link, ATSAM3X8E)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/due_bootloader.elf",
      "device": "ATSAM3X8E",
      "interface": "swd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "configFiles": [
        "${workspaceFolder}/tools/openocd_jlink_swd_sam3x.cfg"
      ],
      "searchDir": [
        "/usr/share/openocd/scripts"
      ],
      "runToEntryPoint": "main",
      "preLaunchTask": "Build (due2)",
      "svdFile": "${workspaceFolder}/svd/SAM3X8E.svd"
    }
  ]
}
