{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clear(due2)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-E",
        "remove_directory",
        "${workspaceFolder}/build"
      ],
      "problemMatcher": []
    },
    {
      "label": "configure (due2)",
      "type": "shell",
      "dependsOn": "clear(due2)",
      "command": "cmake",
      "args": [
        "--fresh",
        "-G",
        "Ninja",
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_TOOLCHAIN_FILE:FILEPATH=${workspaceFolder}/cmake/arm-none-eabi.cmake",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build (due2)",
      "type": "shell",
      "dependsOn": "configure (due2)",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "all"],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Flash APP (OpenOCD+J-Link, SAM3X8E, Due2)",
      "type": "shell",
      "dependsOn": "Build (due2)",
      "command": "openocd",
      "args": [
        "-f",
        "${workspaceFolder}/tools/openocd_jlink_swd_sam3x.cfg",
        "-c",
        "program ${workspaceFolder}/build/due_app.elf verify reset exit"
      ],
      "problemMatcher": []
    },
    {
      "label": "Flash Bootloader (OpenOCD+J-Link, SAM3X8E, Due2)",
      "type": "shell",
      "dependsOn": "Build (due2)",
      "command": "openocd",
      "args": [
        "-f",
        "${workspaceFolder}/tools/openocd_jlink_swd_sam3x.cfg",
        "-c",
        "program ${workspaceFolder}/build/due_bootloader.elf verify reset exit"
      ],
      "problemMatcher": []
    },
    {
      "label": "Flash Full (BL+APP, OpenOCD+J-Link, Due2)",
      "type": "shell",
      "dependsOn": "Build (due2)",
      "command": "openocd",
      "args": [
        "-f",
        "${workspaceFolder}/tools/openocd_jlink_swd_sam3x.cfg",
        "-c",
        "program ${workspaceFolder}/build/due_bootloader.elf verify",
        "-c",
        "program ${workspaceFolder}/build/due_app.elf verify reset exit"
      ],
      "problemMatcher": []
    }
  ]
}
